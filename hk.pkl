// Git hooks for feather.
//
// Deliberately fast checks only. `cargo clippy --all-features` is excluded as a
// policy choice rather than a necessity now that DuckDB is downloaded rather
// than compiled: it builds the whole workspace with every feature, and that is
// a CI job's cost, not a commit hook's. Run it with `mise run lint:rust`
// instead. The `fix` hook below can still autofix, and it is opt-in via
// `hk fix`.
//
// Git here is 2.50, below the 2.54 cutoff, so `hk install` writes a script shim
// into .git/hooks/ rather than using config-based hooks. `hk install --global`
// requires 2.54 and is therefore unavailable.
amends "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  // ---- Rust: formatting only. See the note above about clippy. ----
  ["cargo-fmt"] = Builtins.cargo_fmt

  // ---- Python ----
  ["ruff"] = Builtins.ruff
  ["ruff-format"] = Builtins.ruff_format

  // ---- Everything else: JSON, TOML, YAML, Markdown, Dockerfile ----
  // dprint owns every non-Rust, non-Python file type. Its plugin list lives in
  // dprint.json; this step just hands it the staged files.
  ["dprint"] = new Step {
    glob = List(
      "**/*.json",
      "**/*.jsonc",
      "**/*.toml",
      "**/*.md",
      "**/*.markdown",
      "**/*.yml",
      "**/*.yaml",
      "**/Dockerfile",
      "**/docker-compose.yml",
    )
    check = "dprint check {{files}}"
    fix = "dprint fmt {{files}}"
  }
}

// Refuses a push that would update `refs/heads/main`.
//
// Reads the refs Git pipes to the hook, not the checked-out branch. The
// `no_commit_to_branch` builtin runs `hk util no-commit-to-branch`, which reads
// `git symbolic-ref --short HEAD`: that would block `git push origin feature`
// while on main, and allow `git push origin feature:main` while on a branch. The
// second case is the hole this exists to close, so the builtin is the wrong tool
// here despite the name.
//
// A hook is local, so it only guards a clone where it is installed, and
// `git push --no-verify` skips it. The backstop is server-side: `main` is a
// protected branch requiring all five checks, so a push that skips the hook
// still cannot land. What the hook buys is the failure arriving in a second
// rather than after the Rust build. See README "Contributing".
local noPushToMain = new Step {
  // Git's pre-push stdin, one line per ref being pushed:
  // `<local-ref> <local-sha> <remote-ref> <remote-sha>`.
  stdin = "{{ hook_stdin }}"
  check = """
    if awk '$3 == "refs/heads/main" { found = 1 } END { exit found ? 0 : 1 }'; then
      echo "Refusing to push to main. Open a pull request instead." >&2
      exit 1
    fi
    """
}

hooks {
  ["pre-commit"] {
    // Check only. Autofix on every commit is surprising; use `hk fix`.
    fix = false
    steps = linters
  }
  ["pre-push"] {
    // Listed first so it reports before the linters do, though steps run
    // concurrently: a failing linter blocks the push too.
    steps = new Mapping<String, Step> {
      ["no-push-to-main"] = noPushToMain
      ...linters
    }
  }
  ["check"] {
    steps = linters
  }
  ["fix"] {
    fix = true
    stash = "git"
    steps = linters
  }
}
